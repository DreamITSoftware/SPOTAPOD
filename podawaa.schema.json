{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "podawaa2024",
  "description": "Likes and Views are 'indicators of social media influence' under 16 CFR 465.1(j), governed by 16 CFR 465.8 (see docs/regulatory-context.md). This schema makes no legal determination about any record.",
  "type": "object",
  "required": ["Posts"],
  "properties": {
    "Posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "linkedinPostId": { "type": ["integer", "null"] },
          "Content": { "type": ["string", "null"] },
          "AuthorPublicIdentifier": { "type": ["string", "null"] },
          "Likes": { "type": "integer", "minimum": 0 },
          "Views": { "type": "integer", "minimum": 0 }
        },
        "required": ["Likes", "Views"]
      }
    }
  }
}
